# FinPilot AI — Streamlit Secrets Configuration Example
# Rename this file to secrets.toml or paste into Streamlit Cloud App Settings -> Secrets

# 1. Google Gemini API Key (Free key at https://aistudio.google.com/)
GEMINI_API_KEY = "your_real_gemini_api_key_here"
GEMINI_MODEL = "gemini-3.8-flash"

# 2. Financial News API Key (Free key at https://finnhub.io/)
FINNHUB_API_KEY = "your_real_finnhub_key_here"
NEWS_PROVIDER = "finnhub"

# 3. Market Data Provider Selection (yfinance zero-config public provider)
MARKET_DATA_PROVIDER = "auto"

# 4. SEC EDGAR User-Agent (Format: YourAppName contact@domain.com)
SEC_USER_AGENT = "FinPilotAI research@university.edu"

# 5. Database Connection (SQLite default for cloud single-container deployment)
DATABASE_URL = "sqlite:///finpilot.db"

# 6. Artifact Storage
MODEL_DIR = "artifacts/models"
CHROMA_DIR = "artifacts/vector_db"
LOG_DIR = "artifacts/logs"
