# FinPilot AI — Streamlit Community Cloud Secrets Configuration Example
# Copy this structure into Streamlit Community Cloud App Settings -> Secrets
# OR for local development, copy to .streamlit/secrets.toml (NEVER commit secrets.toml to Git)

# 1. Google Gemini AI (Required for RAG evidence synthesis and AI assistant explanations)
# Get a free key at: https://aistudio.google.com/
GEMINI_API_KEY = "your-gemini-api-key-here"
GEMINI_MODEL = "gemini-3.8-flash"

# 2. Financial News Providers (Optional: automated fallback is active if omitted)
# Free Finnhub key: https://finnhub.io/
FINNHUB_API_KEY = "your-finnhub-api-key-here"
NEWS_PROVIDER = "finnhub"

# 3. Market Data Providers (Optional: yfinance works zero-config without keys)
# EODHD_API_KEY = "your-eodhd-key"
# FMP_API_KEY = "your-fmp-key"
MARKET_DATA_PROVIDER = "auto"

# 4. Regulatory Filings (SEC EDGAR requires User-Agent: AppName contact@domain.com)
SEC_USER_AGENT = "FinPilotAI research@university.edu"

# 5. Database Connection (SQLite by default; for cloud persistence use PostgreSQL / Supabase)
# SQLite on Streamlit Cloud is ephemeral between container cold starts
DATABASE_URL = "sqlite:///finpilot.db"

# 6. Artifact Storage Directories
MODEL_DIR = "artifacts/models"
CHROMA_DIR = "artifacts/vector_db"
LOG_DIR = "artifacts/logs"
