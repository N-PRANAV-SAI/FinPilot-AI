# FinPilot AI — Environment Configuration Template
# Copy this file to .env for local testing (DO NOT COMMIT .env TO GIT)

# 1. Generative AI (Google Gemini) - Free at https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash

# 2. Global Financial Market Data Providers (Optional - yfinance works zero-config)
EODHD_API_KEY=your_eodhd_key_here
FMP_API_KEY=your_fmp_key_here
MARKET_DATA_PROVIDER=auto

# 3. Financial News Providers (Optional - automated fallback is active if omitted)
FINNHUB_API_KEY=your_finnhub_key_here
NEWSAPI_KEY=your_newsapi_key_here
NEWS_PROVIDER=finnhub

# 4. Regulatory Filings (SEC EDGAR requires User-Agent: AppName contact@domain.com)
SEC_USER_AGENT=FinPilotAI research@university.edu

# 5. Database & Artifact Storage
DATABASE_URL=sqlite:///finpilot.db
MODEL_DIR=artifacts/models
CHROMA_DIR=artifacts/vector_db
LOG_DIR=artifacts/logs
CHART_DIR=artifacts/charts
